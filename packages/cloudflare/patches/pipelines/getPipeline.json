{
  "description": "Align pipelines#Get with distilled cloudflare/pipelines getPipeline",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.pipelines#Get",
      "path": "/shapes/com.cloudflare.pipelines#GetPipeline"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.pipelines#GetRequest",
      "path": "/shapes/com.cloudflare.pipelines#GetPipelineRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.pipelines#GetPipeline/input/target",
      "value": "com.cloudflare.pipelines#GetPipelineRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.pipelines#GetResponse",
      "path": "/shapes/com.cloudflare.pipelines#GetPipelineResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.pipelines#GetPipeline/output/target",
      "value": "com.cloudflare.pipelines#GetPipelineResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.pipelines#PipelineNotExists",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 1000
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.pipelines#GetPipeline/errors",
      "value": [
        {
          "target": "com.cloudflare.pipelines#PipelineNotExists"
        }
      ]
    }
  ]
}
