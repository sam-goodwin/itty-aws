    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.accounts#TokensPermissionGroupsList/errors",
      "value": [
        {
          "target": "com.cloudflare.accounts#InvalidRoute"
        }
      ]
    }
  ]
}
