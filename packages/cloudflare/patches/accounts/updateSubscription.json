{
  "description": "Align accounts#SubscriptionsUpdate with distilled cloudflare/accounts updateSubscription",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.accounts#SubscriptionsUpdate",
      "path": "/shapes/com.cloudflare.accounts#UpdateSubscription"
    },
    {
