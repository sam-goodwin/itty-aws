      "value": "com.cloudflare.accounts#UpdateSubscriptionResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.accounts#JsonDecodeFailure",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
