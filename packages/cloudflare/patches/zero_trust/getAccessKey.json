{
  "description": "Align zero_trust#AccessKeysGet with distilled cloudflare/zero-trust getAccessKey",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.zero_trust#AccessKeysGet",
      "path": "/shapes/com.cloudflare.zero_trust#GetAccessKey"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.zero_trust#AccessKeysGetRequest",
      "path": "/shapes/com.cloudflare.zero_trust#GetAccessKeyRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.zero_trust#GetAccessKey/input/target",
      "value": "com.cloudflare.zero_trust#GetAccessKeyRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.zero_trust#AccessKeysGetResponse",
      "path": "/shapes/com.cloudflare.zero_trust#GetAccessKeyResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.zero_trust#GetAccessKey/output/target",
      "value": "com.cloudflare.zero_trust#GetAccessKeyResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.zero_trust#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.zero_trust#GetAccessKey/errors",
      "value": [
        {
          "target": "com.cloudflare.zero_trust#Forbidden"
        }
      ]
    }
  ]
}
