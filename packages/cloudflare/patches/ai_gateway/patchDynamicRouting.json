    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.ai_gateway#PatchDynamicRouting/output/target",
      "value": "com.cloudflare.ai_gateway#PatchDynamicRoutingResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.ai_gateway#RouteNotFound",
      "value": {
        "type": "structure",
