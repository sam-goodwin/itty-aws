{
  "description": "Align ai_gateway#DynamicRoutingGet with distilled cloudflare/ai-gateway getDynamicRouting",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ai_gateway#DynamicRoutingGet",
      "path": "/shapes/com.cloudflare.ai_gateway#GetDynamicRouting"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ai_gateway#DynamicRoutingGetRequest",
      "path": "/shapes/com.cloudflare.ai_gateway#GetDynamicRoutingRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.ai_gateway#GetDynamicRouting/input/target",
      "value": "com.cloudflare.ai_gateway#GetDynamicRoutingRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ai_gateway#DynamicRoutingGetResponse",
      "path": "/shapes/com.cloudflare.ai_gateway#GetDynamicRoutingResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.ai_gateway#GetDynamicRouting/output/target",
      "value": "com.cloudflare.ai_gateway#GetDynamicRoutingResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.ai_gateway#RouteNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 7005,
              "message": {
                "includes": "not found"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.ai_gateway#GatewayNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 7002
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.ai_gateway#GetDynamicRouting/errors",
      "value": [
        {
          "target": "com.cloudflare.ai_gateway#RouteNotFound"
        },
        {
          "target": "com.cloudflare.ai_gateway#GatewayNotFound"
        }
      ]
    }
  ]
}
