{
  "description": "Align custom_certificates#Delete with distilled cloudflare/custom-certificates deleteCustomCertificate",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.custom_certificates#Delete",
      "path": "/shapes/com.cloudflare.custom_certificates#DeleteCustomCertificate"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.custom_certificates#DeleteRequest",
      "path": "/shapes/com.cloudflare.custom_certificates#DeleteCustomCertificateRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.custom_certificates#DeleteCustomCertificate/input/target",
      "value": "com.cloudflare.custom_certificates#DeleteCustomCertificateRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.custom_certificates#DeleteResponse",
      "path": "/shapes/com.cloudflare.custom_certificates#DeleteCustomCertificateResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.custom_certificates#DeleteCustomCertificate/output/target",
      "value": "com.cloudflare.custom_certificates#DeleteCustomCertificateResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.custom_certificates#CustomCertificateNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 404
            },
            {
              "code": 1002,
              "message": {
                "includes": "Invalid certificate"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.custom_certificates#PlanLevelNotAllowed",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 1011
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.custom_certificates#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.custom_certificates#DeleteCustomCertificate/errors",
      "value": [
        {
          "target": "com.cloudflare.custom_certificates#CustomCertificateNotFound"
        },
        {
          "target": "com.cloudflare.custom_certificates#PlanLevelNotAllowed"
        },
        {
          "target": "com.cloudflare.custom_certificates#Forbidden"
        }
      ]
    }
  ]
}
