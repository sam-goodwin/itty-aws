{
  "description": "Align magic_transit#SitesList with distilled cloudflare/magic-transit listSites",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.magic_transit#SitesList",
      "path": "/shapes/com.cloudflare.magic_transit#ListSites"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.magic_transit#SitesListRequest",
      "path": "/shapes/com.cloudflare.magic_transit#ListSitesRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.magic_transit#ListSites/input/target",
      "value": "com.cloudflare.magic_transit#ListSitesRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.magic_transit#SitesListResponse",
      "path": "/shapes/com.cloudflare.magic_transit#ListSitesResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.magic_transit#ListSites/output/target",
      "value": "com.cloudflare.magic_transit#ListSitesResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.magic_transit#MagicWanUnauthorized",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 1025
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.magic_transit#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.magic_transit#ListSites/errors",
      "value": [
        {
          "target": "com.cloudflare.magic_transit#MagicWanUnauthorized"
        },
        {
          "target": "com.cloudflare.magic_transit#Forbidden"
        }
      ]
    }
  ]
}
