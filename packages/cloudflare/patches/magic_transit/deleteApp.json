    {
      "op": "add",
      "path": "/shapes/com.cloudflare.magic_transit#DeleteApp/errors",
      "value": [
        {
          "target": "com.cloudflare.magic_transit#AppNotFound"
        },
        {
          "target": "com.cloudflare.magic_transit#MagicWanUnauthorized"
        },
