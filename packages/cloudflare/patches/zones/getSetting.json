{
  "description": "Align zones#SettingsGet with distilled cloudflare/zones getSetting",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.zones#SettingsGet",
      "path": "/shapes/com.cloudflare.zones#GetSetting"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.zones#SettingsGetRequest",
      "path": "/shapes/com.cloudflare.zones#GetSettingRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.zones#GetSetting/input/target",
      "value": "com.cloudflare.zones#GetSettingRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.zones#SettingsGetResponse",
      "path": "/shapes/com.cloudflare.zones#GetSettingResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.zones#GetSetting/output/target",
      "value": "com.cloudflare.zones#GetSettingResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.zones#InvalidZoneIdentifier",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 9109,
              "message": {
                "includes": "Invalid zone identifier"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.zones#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.zones#GetSetting/errors",
      "value": [
        {
          "target": "com.cloudflare.zones#InvalidZoneIdentifier"
        },
        {
          "target": "com.cloudflare.zones#Forbidden"
        }
      ]
    }
  ]
}
