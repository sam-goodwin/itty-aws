{
  "description": "Align dns#RecordsCreate with distilled cloudflare/dns createRecord",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.dns#RecordsCreate",
      "path": "/shapes/com.cloudflare.dns#CreateRecord"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.dns#RecordsCreateRequest",
      "path": "/shapes/com.cloudflare.dns#CreateRecordRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.dns#CreateRecord/input/target",
      "value": "com.cloudflare.dns#CreateRecordRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.dns#RecordsCreateResponse",
      "path": "/shapes/com.cloudflare.dns#CreateRecordResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.dns#CreateRecord/output/target",
      "value": "com.cloudflare.dns#CreateRecordResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.dns#DnsRecordAlreadyExists",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 81057
            },
            {
              "code": 81058
            },
            {
              "status": 400,
              "message": {
                "includes": "identical record already exists"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.dns#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.dns#CreateRecord/errors",
      "value": [
        {
          "target": "com.cloudflare.dns#DnsRecordAlreadyExists"
        },
        {
          "target": "com.cloudflare.dns#Forbidden"
        }
      ]
    }
  ]
}
