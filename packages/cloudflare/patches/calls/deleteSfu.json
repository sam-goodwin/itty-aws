            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.calls#DeleteSfu/errors",
      "value": [
        {
          "target": "com.cloudflare.calls#CallsAppNotFound"
