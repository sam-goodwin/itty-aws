{
  "description": "Align calls#TurnDelete with distilled cloudflare/calls deleteTurn",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.calls#TurnDelete",
      "path": "/shapes/com.cloudflare.calls#DeleteTurn"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.calls#TurnDeleteRequest",
      "path": "/shapes/com.cloudflare.calls#DeleteTurnRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.calls#DeleteTurn/input/target",
      "value": "com.cloudflare.calls#DeleteTurnRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.calls#TurnDeleteResponse",
      "path": "/shapes/com.cloudflare.calls#DeleteTurnResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.calls#DeleteTurn/output/target",
      "value": "com.cloudflare.calls#DeleteTurnResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.calls#TurnKeyNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 20008
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.calls#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.calls#DeleteTurn/errors",
      "value": [
        {
          "target": "com.cloudflare.calls#TurnKeyNotFound"
        },
        {
          "target": "com.cloudflare.calls#Forbidden"
        }
      ]
    }
  ]
}
