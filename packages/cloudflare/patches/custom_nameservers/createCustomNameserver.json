{
  "description": "Align custom_nameservers#Create with distilled cloudflare/custom-nameservers createCustomNameserver",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.custom_nameservers#Create",
      "path": "/shapes/com.cloudflare.custom_nameservers#CreateCustomNameserver"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.custom_nameservers#CreateRequest",
      "path": "/shapes/com.cloudflare.custom_nameservers#CreateCustomNameserverRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.custom_nameservers#CreateCustomNameserver/input/target",
      "value": "com.cloudflare.custom_nameservers#CreateCustomNameserverRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.custom_nameservers#CreateResponse",
      "path": "/shapes/com.cloudflare.custom_nameservers#CreateCustomNameserverResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.custom_nameservers#CreateCustomNameserver/output/target",
      "value": "com.cloudflare.custom_nameservers#CreateCustomNameserverResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.custom_nameservers#CustomNameserversNotEnabled",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 1002,
              "message": {
                "includes": "not enabled"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.custom_nameservers#CustomNameserverAlreadyExists",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "message": {
                "includes": "already exist"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.custom_nameservers#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.custom_nameservers#CreateCustomNameserver/errors",
      "value": [
        {
          "target": "com.cloudflare.custom_nameservers#CustomNameserversNotEnabled"
        },
        {
          "target": "com.cloudflare.custom_nameservers#CustomNameserverAlreadyExists"
        },
        {
          "target": "com.cloudflare.custom_nameservers#Forbidden"
        }
      ]
    }
  ]
}
