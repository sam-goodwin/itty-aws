{
  "description": "Align spectrum#AppsList with distilled cloudflare/spectrum listApps",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.spectrum#AppsList",
      "path": "/shapes/com.cloudflare.spectrum#ListApps"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.spectrum#AppsListRequest",
      "path": "/shapes/com.cloudflare.spectrum#ListAppsRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.spectrum#ListApps/input/target",
      "value": "com.cloudflare.spectrum#ListAppsRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.spectrum#AppsListResponse",
      "path": "/shapes/com.cloudflare.spectrum#ListAppsResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.spectrum#ListApps/output/target",
      "value": "com.cloudflare.spectrum#ListAppsResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.spectrum#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.spectrum#ListApps/errors",
      "value": [
        {
          "target": "com.cloudflare.spectrum#Forbidden"
        }
      ]
    }
  ]
}
