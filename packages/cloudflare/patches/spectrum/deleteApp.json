{
  "description": "Align spectrum#AppsDelete with distilled cloudflare/spectrum deleteApp",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.spectrum#AppsDelete",
      "path": "/shapes/com.cloudflare.spectrum#DeleteApp"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.spectrum#AppsDeleteRequest",
      "path": "/shapes/com.cloudflare.spectrum#DeleteAppRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.spectrum#DeleteApp/input/target",
      "value": "com.cloudflare.spectrum#DeleteAppRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.spectrum#AppsDeleteResponse",
      "path": "/shapes/com.cloudflare.spectrum#DeleteAppResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.spectrum#DeleteApp/output/target",
      "value": "com.cloudflare.spectrum#DeleteAppResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.spectrum#SpectrumAppNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 10006
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.spectrum#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.spectrum#DeleteApp/errors",
      "value": [
        {
          "target": "com.cloudflare.spectrum#SpectrumAppNotFound"
        },
        {
          "target": "com.cloudflare.spectrum#Forbidden"
        }
      ]
    }
  ]
}
