{
  "description": "Align hostnames#SettingsTlsGet with distilled cloudflare/hostnames getSettingTls",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.hostnames#SettingsTlsGet",
      "path": "/shapes/com.cloudflare.hostnames#GetSettingTls"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.hostnames#SettingsTlsGetRequest",
      "path": "/shapes/com.cloudflare.hostnames#GetSettingTlsRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.hostnames#GetSettingTls/input/target",
      "value": "com.cloudflare.hostnames#GetSettingTlsRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.hostnames#SettingsTlsGetResponse",
      "path": "/shapes/com.cloudflare.hostnames#GetSettingTlsResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.hostnames#GetSettingTls/output/target",
      "value": "com.cloudflare.hostnames#GetSettingTlsResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.hostnames#GetSettingTls/traits/smithy.api#paginated",
      "value": {
        "mode": "single",
        "items": "result"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.hostnames#AdvancedCertificateManagerRequired",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 1450
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.hostnames#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.hostnames#GetSettingTls/errors",
      "value": [
        {
          "target": "com.cloudflare.hostnames#AdvancedCertificateManagerRequired"
        },
        {
          "target": "com.cloudflare.hostnames#Forbidden"
        }
      ]
    }
  ]
}
