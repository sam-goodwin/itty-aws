{
  "description": "Align content_scanning#Update with distilled cloudflare/content-scanning createContentScanning (duplicate export name — errors/pagination only, no rename)",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.content_scanning#ContentScanningNotEntitled",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 400,
              "message": {
                "includes": "not entitled"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.content_scanning#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.content_scanning#Update/errors",
      "value": [
        {
          "target": "com.cloudflare.content_scanning#ContentScanningNotEntitled"
        },
        {
          "target": "com.cloudflare.content_scanning#Forbidden"
        }
      ]
    }
  ]
}
