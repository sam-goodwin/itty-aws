{
  "description": "Align content_scanning#PayloadsList with distilled cloudflare/content-scanning listPayloads",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.content_scanning#PayloadsList",
      "path": "/shapes/com.cloudflare.content_scanning#ListPayloads"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.content_scanning#PayloadsListRequest",
      "path": "/shapes/com.cloudflare.content_scanning#ListPayloadsRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.content_scanning#ListPayloads/input/target",
      "value": "com.cloudflare.content_scanning#ListPayloadsRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.content_scanning#PayloadsListResponse",
      "path": "/shapes/com.cloudflare.content_scanning#ListPayloadsResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.content_scanning#ListPayloads/output/target",
      "value": "com.cloudflare.content_scanning#ListPayloadsResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.content_scanning#ContentScanningNotEnabled",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 400,
              "message": {
                "includes": "File Upload Scan not enabled"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.content_scanning#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.content_scanning#ListPayloads/errors",
      "value": [
        {
          "target": "com.cloudflare.content_scanning#ContentScanningNotEnabled"
        },
        {
          "target": "com.cloudflare.content_scanning#Forbidden"
        }
      ]
    }
  ]
}
