      "value": "com.cloudflare.alerting#UpdateDestinationWebhookRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.alerting#DestinationsWebhooksUpdateResponse",
      "path": "/shapes/com.cloudflare.alerting#UpdateDestinationWebhookResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.alerting#UpdateDestinationWebhook/output/target",
      "value": "com.cloudflare.alerting#UpdateDestinationWebhookResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.alerting#InvalidRoute",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 7003
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.alerting#InvalidWebhookId",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 0,
              "message": {
                "includes": "invalid Webhook ID"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.alerting#WebhookTestFailed",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 0,
              "message": {
                "includes": "Webhook test failed"
              }
            },
            {
              "status": 422,
              "message": {
                "includes": "Webhook test request failed"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.alerting#UpdateDestinationWebhook/errors",
      "value": [
        {
          "target": "com.cloudflare.alerting#InvalidRoute"
        },
        {
          "target": "com.cloudflare.alerting#InvalidWebhookId"
        },
        {
          "target": "com.cloudflare.alerting#WebhookTestFailed"
        }
      ]
    }
  ]
}
