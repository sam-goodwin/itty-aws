{
  "description": "Align alerting#SilencesDelete with distilled cloudflare/alerting deleteSilence",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.alerting#SilencesDelete",
      "path": "/shapes/com.cloudflare.alerting#DeleteSilence"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.alerting#SilencesDeleteRequest",
      "path": "/shapes/com.cloudflare.alerting#DeleteSilenceRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.alerting#DeleteSilence/input/target",
      "value": "com.cloudflare.alerting#DeleteSilenceRequest"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.alerting#InvalidRoute",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 7003
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.alerting#SilenceNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 0,
              "message": {
                "includes": "silence not found"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.alerting#DeleteSilence/errors",
      "value": [
        {
          "target": "com.cloudflare.alerting#InvalidRoute"
        },
        {
          "target": "com.cloudflare.alerting#SilenceNotFound"
        }
      ]
    }
  ]
}
