{
  "description": "Align alerting#DestinationsWebhooksCreate with distilled cloudflare/alerting createDestinationWebhook",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.alerting#DestinationsWebhooksCreate",
      "path": "/shapes/com.cloudflare.alerting#CreateDestinationWebhook"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.alerting#DestinationsWebhooksCreateRequest",
      "path": "/shapes/com.cloudflare.alerting#CreateDestinationWebhookRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.alerting#CreateDestinationWebhook/input/target",
      "value": "com.cloudflare.alerting#CreateDestinationWebhookRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.alerting#DestinationsWebhooksCreateResponse",
      "path": "/shapes/com.cloudflare.alerting#CreateDestinationWebhookResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.alerting#CreateDestinationWebhook/output/target",
      "value": "com.cloudflare.alerting#CreateDestinationWebhookResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.alerting#InvalidRoute",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 7003
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.alerting#WebhookTestFailed",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 0,
              "message": {
                "includes": "Webhook test failed"
              }
            },
            {
              "status": 422,
              "message": {
                "includes": "Webhook test request failed"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.alerting#CreateDestinationWebhook/errors",
      "value": [
        {
          "target": "com.cloudflare.alerting#InvalidRoute"
        },
        {
          "target": "com.cloudflare.alerting#WebhookTestFailed"
        }
      ]
    }
  ]
}
