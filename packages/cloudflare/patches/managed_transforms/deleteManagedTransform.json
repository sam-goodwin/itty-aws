{
  "description": "Align managed_transforms#Delete with distilled cloudflare/managed-transforms deleteManagedTransform",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.managed_transforms#Delete",
      "path": "/shapes/com.cloudflare.managed_transforms#DeleteManagedTransform"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.managed_transforms#DeleteRequest",
      "path": "/shapes/com.cloudflare.managed_transforms#DeleteManagedTransformRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.managed_transforms#DeleteManagedTransform/input/target",
      "value": "com.cloudflare.managed_transforms#DeleteManagedTransformRequest"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.managed_transforms#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.managed_transforms#DeleteManagedTransform/errors",
      "value": [
        {
          "target": "com.cloudflare.managed_transforms#Forbidden"
        }
      ]
    }
  ]
}
