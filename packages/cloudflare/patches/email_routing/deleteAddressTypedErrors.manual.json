{
  "description": "typed errors for destination-address deletes: 2015 gone, 2032 created too recently (port of distilled#392)",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.email_routing#EmailAddressNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": { "target": "smithy.api#Integer" },
          "message": { "target": "smithy.api#String" }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [{ "code": 2015 }]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.email_routing#EmailAddressCreatedTooRecently",
      "value": {
        "type": "structure",
        "members": {
          "code": { "target": "smithy.api#Integer" },
          "message": { "target": "smithy.api#String" }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [{ "code": 2032 }]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.email_routing#DeleteAddress/errors",
      "value": [
        { "target": "com.cloudflare.email_routing#EmailAddressNotFound" },
        {
          "target": "com.cloudflare.email_routing#EmailAddressCreatedTooRecently"
        }
      ]
    }
  ]
}
