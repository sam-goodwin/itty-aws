      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.google_tag_gateway#GetConfig/errors",
      "value": [
        {
          "target": "com.cloudflare.google_tag_gateway#Forbidden"
        }
      ]
    }
  ]
}
