{
  "description": "Align user#TokensUpdate with distilled cloudflare/user updateToken",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.user#TokensUpdate",
      "path": "/shapes/com.cloudflare.user#UpdateToken"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.user#TokensUpdateRequest",
      "path": "/shapes/com.cloudflare.user#UpdateTokenRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.user#UpdateToken/input/target",
      "value": "com.cloudflare.user#UpdateTokenRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.user#TokensUpdateResponse",
      "path": "/shapes/com.cloudflare.user#UpdateTokenResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.user#UpdateToken/output/target",
      "value": "com.cloudflare.user#UpdateTokenResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.user#InvalidRoute",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 7003
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.user#MethodNotAllowed",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 7001
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.user#TokenNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 1003
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.user#PermissionGroupNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 1001,
              "message": {
                "includes": "Permission group"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.user#UpdateToken/errors",
      "value": [
        {
          "target": "com.cloudflare.user#InvalidRoute"
        },
        {
          "target": "com.cloudflare.user#MethodNotAllowed"
        },
        {
          "target": "com.cloudflare.user#TokenNotFound"
        },
        {
          "target": "com.cloudflare.user#PermissionGroupNotFound"
        }
      ]
    }
  ]
}
