{
  "description": "Align ai_search#InstancesDelete with distilled cloudflare/aisearch deleteInstance",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ai_search#InstancesDelete",
      "path": "/shapes/com.cloudflare.ai_search#DeleteInstance"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ai_search#InstancesDeleteRequest",
      "path": "/shapes/com.cloudflare.ai_search#DeleteInstanceRequest"
    },
    {
      "op": "replace",
