      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 1456
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.custom_hostnames#PutFallbackOrigin/errors",
      "value": [
        {
          "target": "com.cloudflare.custom_hostnames#SaasAccessNotGranted"
        }
      ]
    }
  ]
}
