      "path": "/shapes/com.cloudflare.stream#DeleteLiveInputRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.stream#DeleteLiveInput/input/target",
      "value": "com.cloudflare.stream#DeleteLiveInputRequest"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.stream#LiveInputNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 10003
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.stream#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.stream#DeleteLiveInput/errors",
      "value": [
        {
          "target": "com.cloudflare.stream#LiveInputNotFound"
        },
        {
          "target": "com.cloudflare.stream#Forbidden"
        }
      ]
    }
  ]
}
