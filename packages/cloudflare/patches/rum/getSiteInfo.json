{
  "description": "Align rum#SiteInfoGet with distilled cloudflare/rum getSiteInfo",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.rum#SiteInfoGet",
      "path": "/shapes/com.cloudflare.rum#GetSiteInfo"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.rum#SiteInfoGetRequest",
      "path": "/shapes/com.cloudflare.rum#GetSiteInfoRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.rum#GetSiteInfo/input/target",
      "value": "com.cloudflare.rum#GetSiteInfoRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.rum#SiteInfoGetResponse",
      "path": "/shapes/com.cloudflare.rum#GetSiteInfoResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.rum#GetSiteInfo/output/target",
      "value": "com.cloudflare.rum#GetSiteInfoResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.rum#SiteNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 10015
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.rum#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.rum#GetSiteInfo/errors",
      "value": [
        {
          "target": "com.cloudflare.rum#SiteNotFound"
        },
        {
          "target": "com.cloudflare.rum#Forbidden"
        }
      ]
    }
  ]
}
