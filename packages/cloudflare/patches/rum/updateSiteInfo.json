{
  "description": "Align rum#SiteInfoUpdate with distilled cloudflare/rum updateSiteInfo",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.rum#SiteInfoUpdate",
      "path": "/shapes/com.cloudflare.rum#UpdateSiteInfo"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.rum#SiteInfoUpdateRequest",
      "path": "/shapes/com.cloudflare.rum#UpdateSiteInfoRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.rum#UpdateSiteInfo/input/target",
      "value": "com.cloudflare.rum#UpdateSiteInfoRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.rum#SiteInfoUpdateResponse",
      "path": "/shapes/com.cloudflare.rum#UpdateSiteInfoResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.rum#UpdateSiteInfo/output/target",
      "value": "com.cloudflare.rum#UpdateSiteInfoResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.rum#SiteNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 10015
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.rum#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.rum#UpdateSiteInfo/errors",
      "value": [
        {
          "target": "com.cloudflare.rum#SiteNotFound"
        },
        {
          "target": "com.cloudflare.rum#Forbidden"
        }
      ]
    }
  ]
}
