{
  "description": "Align kv#NamespacesCreate with distilled cloudflare/kv createNamespace",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.kv#NamespacesCreate",
      "path": "/shapes/com.cloudflare.kv#CreateNamespace"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.kv#NamespacesCreateRequest",
      "path": "/shapes/com.cloudflare.kv#CreateNamespaceRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.kv#CreateNamespace/input/target",
      "value": "com.cloudflare.kv#CreateNamespaceRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.kv#NamespacesCreateResponse",
      "path": "/shapes/com.cloudflare.kv#CreateNamespaceResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.kv#CreateNamespace/output/target",
      "value": "com.cloudflare.kv#CreateNamespaceResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.kv#TitleRequired",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 10019
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.kv#InvalidObjectIdentifier",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 7003
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.kv#NamespaceTitleAlreadyExists",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 10014
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.kv#CreateNamespace/errors",
      "value": [
        {
          "target": "com.cloudflare.kv#TitleRequired"
        },
        {
          "target": "com.cloudflare.kv#InvalidObjectIdentifier"
        },
        {
          "target": "com.cloudflare.kv#NamespaceTitleAlreadyExists"
        }
      ]
    }
  ]
}
