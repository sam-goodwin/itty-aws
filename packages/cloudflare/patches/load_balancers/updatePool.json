    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.load_balancers#PoolsUpdateResponse",
      "path": "/shapes/com.cloudflare.load_balancers#UpdatePoolResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.load_balancers#UpdatePool/output/target",
      "value": "com.cloudflare.load_balancers#UpdatePoolResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.load_balancers#PoolNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 1001
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.load_balancers#PoolAccessFailed",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 1002,
              "message": {
                "includes": "Access Failed"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.load_balancers#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.load_balancers#UpdatePool/errors",
      "value": [
        {
          "target": "com.cloudflare.load_balancers#PoolNotFound"
        },
        {
          "target": "com.cloudflare.load_balancers#PoolAccessFailed"
        },
        {
          "target": "com.cloudflare.load_balancers#Forbidden"
        }
      ]
    }
  ]
}
