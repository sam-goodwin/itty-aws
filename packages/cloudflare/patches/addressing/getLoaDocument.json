{
  "description": "Align addressing#LoaDocumentsGet with distilled cloudflare/addressing getLoaDocument",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.addressing#LoaDocumentsGet",
      "path": "/shapes/com.cloudflare.addressing#GetLoaDocument"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.addressing#LoaDocumentsGetRequest",
      "path": "/shapes/com.cloudflare.addressing#GetLoaDocumentRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.addressing#GetLoaDocument/input/target",
      "value": "com.cloudflare.addressing#GetLoaDocumentRequest"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.addressing#LoaDocumentNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 1000
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.addressing#InvalidAccountId",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 7003,
              "message": {
                "includes": "Could not route"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.addressing#GetLoaDocument/errors",
      "value": [
        {
          "target": "com.cloudflare.addressing#LoaDocumentNotFound"
        },
        {
          "target": "com.cloudflare.addressing#InvalidAccountId"
        }
      ]
    }
  ]
}
