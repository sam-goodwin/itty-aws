{
  "description": "Align addressing#PrefixesDelegationsList with distilled cloudflare/addressing listPrefixDelegations",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.addressing#PrefixesDelegationsList",
      "path": "/shapes/com.cloudflare.addressing#ListPrefixDelegations"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.addressing#PrefixesDelegationsListRequest",
      "path": "/shapes/com.cloudflare.addressing#ListPrefixDelegationsRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.addressing#ListPrefixDelegations/input/target",
      "value": "com.cloudflare.addressing#ListPrefixDelegationsRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.addressing#PrefixesDelegationsListResponse",
      "path": "/shapes/com.cloudflare.addressing#ListPrefixDelegationsResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.addressing#ListPrefixDelegations/output/target",
      "value": "com.cloudflare.addressing#ListPrefixDelegationsResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.addressing#PrefixNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 1000,
              "message": {
                "includes": "not_found"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.addressing#InvalidAccountId",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 7003,
              "message": {
                "includes": "Could not route"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.addressing#ListPrefixDelegations/errors",
      "value": [
        {
          "target": "com.cloudflare.addressing#PrefixNotFound"
        },
        {
          "target": "com.cloudflare.addressing#InvalidAccountId"
        }
      ]
    }
  ]
}
