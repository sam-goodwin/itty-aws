{
  "description": "Align addressing#PrefixesCreate with distilled cloudflare/addressing createPrefix",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.addressing#PrefixesCreate",
      "path": "/shapes/com.cloudflare.addressing#CreatePrefix"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.addressing#PrefixesCreateRequest",
      "path": "/shapes/com.cloudflare.addressing#CreatePrefixRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.addressing#CreatePrefix/input/target",
      "value": "com.cloudflare.addressing#CreatePrefixRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.addressing#PrefixesCreateResponse",
      "path": "/shapes/com.cloudflare.addressing#CreatePrefixResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.addressing#CreatePrefix/output/target",
      "value": "com.cloudflare.addressing#CreatePrefixResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.addressing#InvalidAccountId",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 7003,
              "message": {
                "includes": "Could not route"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.addressing#InvalidNetworkCidr",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 1001,
              "message": {
                "includes": "invalid_network_cidr"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.addressing#IrrEntryNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 1003,
              "message": {
                "includes": "irr_entry_not_found"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.addressing#CreatePrefix/errors",
      "value": [
        {
          "target": "com.cloudflare.addressing#InvalidAccountId"
        },
        {
          "target": "com.cloudflare.addressing#InvalidNetworkCidr"
        },
        {
          "target": "com.cloudflare.addressing#IrrEntryNotFound"
        }
      ]
    }
  ]
}
