{
  "description": "Align page_shield#PoliciesCreate with distilled cloudflare/page-shield createPolicy",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.page_shield#PoliciesCreate",
      "path": "/shapes/com.cloudflare.page_shield#CreatePolicy"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.page_shield#PoliciesCreateRequest",
      "path": "/shapes/com.cloudflare.page_shield#CreatePolicyRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.page_shield#CreatePolicy/input/target",
      "value": "com.cloudflare.page_shield#CreatePolicyRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.page_shield#PoliciesCreateResponse",
      "path": "/shapes/com.cloudflare.page_shield#CreatePolicyResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.page_shield#CreatePolicy/output/target",
      "value": "com.cloudflare.page_shield#CreatePolicyResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.page_shield#PolicyQuotaExceeded",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 400,
              "message": {
                "includes": "exceeded the maximum number of rules in the phase http_response_page_shield"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.page_shield#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.page_shield#CreatePolicy/errors",
      "value": [
        {
          "target": "com.cloudflare.page_shield#PolicyQuotaExceeded"
        },
        {
          "target": "com.cloudflare.page_shield#Forbidden"
        }
      ]
    }
  ]
}
