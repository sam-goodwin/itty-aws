{
  "description": "Align workflows#InstancesGet with distilled cloudflare/workflows getInstance",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workflows#InstancesGet",
      "path": "/shapes/com.cloudflare.workflows#GetInstance"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workflows#InstancesGetRequest",
      "path": "/shapes/com.cloudflare.workflows#GetInstanceRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workflows#GetInstance/input/target",
      "value": "com.cloudflare.workflows#GetInstanceRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workflows#InstancesGetResponse",
      "path": "/shapes/com.cloudflare.workflows#GetInstanceResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workflows#GetInstance/output/target",
      "value": "com.cloudflare.workflows#GetInstanceResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workflows#WorkflowNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 10200
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workflows#InvalidRoute",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 7003
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workflows#InstanceNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 10400
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workflows#GetInstance/errors",
      "value": [
        {
          "target": "com.cloudflare.workflows#WorkflowNotFound"
        },
        {
          "target": "com.cloudflare.workflows#InvalidRoute"
        },
        {
          "target": "com.cloudflare.workflows#InstanceNotFound"
        }
      ]
    }
  ]
}
