{
  "description": "Align argo#TieredCachingEdit with distilled cloudflare/argo patchTieredCaching",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.argo#TieredCachingEdit",
      "path": "/shapes/com.cloudflare.argo#PatchTieredCaching"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.argo#TieredCachingEditRequest",
      "path": "/shapes/com.cloudflare.argo#PatchTieredCachingRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.argo#PatchTieredCaching/input/target",
      "value": "com.cloudflare.argo#PatchTieredCachingRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.argo#TieredCachingEditResponse",
      "path": "/shapes/com.cloudflare.argo#PatchTieredCachingResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.argo#PatchTieredCaching/output/target",
      "value": "com.cloudflare.argo#PatchTieredCachingResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.argo#InvalidObjectIdentifier",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 7003
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.argo#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.argo#PatchTieredCaching/errors",
      "value": [
        {
          "target": "com.cloudflare.argo#InvalidObjectIdentifier"
        },
        {
          "target": "com.cloudflare.argo#Forbidden"
        }
      ]
    }
  ]
}
