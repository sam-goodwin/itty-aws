    {
      "op": "add",
      "path": "/shapes/com.cloudflare.origin_tls_client_auth#ZoneCertificatesCreate/errors",
      "value": [
        {
          "target": "com.cloudflare.origin_tls_client_auth#CertificateAlreadyExists"
