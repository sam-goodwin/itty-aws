          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 409
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.origin_tls_client_auth#Forbidden",
      "value": {
        "type": "structure",
