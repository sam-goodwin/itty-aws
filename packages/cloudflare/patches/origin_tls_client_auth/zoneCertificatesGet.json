{
  "description": "Align origin_tls_client_auth#ZoneCertificatesGet with distilled cloudflare/origin-tls-client-auth getOriginTlsClientAuth (duplicate export name — errors/pagination only, no rename)",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.origin_tls_client_auth#CertificateNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 1552,
              "message": {
                "includes": "certificate not found"
              }
            },
            {
              "status": 404
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.origin_tls_client_auth#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.origin_tls_client_auth#ZoneCertificatesGet/errors",
      "value": [
        {
          "target": "com.cloudflare.origin_tls_client_auth#CertificateNotFound"
        },
        {
          "target": "com.cloudflare.origin_tls_client_auth#Forbidden"
        }
      ]
    }
  ]
}
