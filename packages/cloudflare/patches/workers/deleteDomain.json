{
  "description": "Align workers#DomainsDelete with distilled cloudflare/workers deleteDomain",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#DomainsDelete",
      "path": "/shapes/com.cloudflare.workers#DeleteDomain"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#DomainsDeleteRequest",
      "path": "/shapes/com.cloudflare.workers#DeleteDomainRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#DeleteDomain/input/target",
      "value": "com.cloudflare.workers#DeleteDomainRequest"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#DomainNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 100114
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#DeleteDomain/errors",
      "value": [
        {
          "target": "com.cloudflare.workers#DomainNotFound"
        }
      ]
    }
  ]
}
