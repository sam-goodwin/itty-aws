{
  "description": "Align workers#ScriptsSecretsUpdate with distilled cloudflare/workers putScriptSecret",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#ScriptsSecretsUpdate",
      "path": "/shapes/com.cloudflare.workers#PutScriptSecret"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#ScriptsSecretsUpdateRequest",
      "path": "/shapes/com.cloudflare.workers#PutScriptSecretRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#PutScriptSecret/input/target",
      "value": "com.cloudflare.workers#PutScriptSecretRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#ScriptsSecretsUpdateResponse",
      "path": "/shapes/com.cloudflare.workers#PutScriptSecretResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#PutScriptSecret/output/target",
      "value": "com.cloudflare.workers#PutScriptSecretResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#WorkerNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 10007
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#PutScriptSecret/errors",
      "value": [
        {
          "target": "com.cloudflare.workers#WorkerNotFound"
        }
      ]
    }
  ]
}
