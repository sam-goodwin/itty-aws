      "from": "/shapes/com.cloudflare.workers#ScriptsVersionsGetRequest",
      "path": "/shapes/com.cloudflare.workers#GetScriptVersionRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#GetScriptVersion/input/target",
      "value": "com.cloudflare.workers#GetScriptVersionRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#ScriptsVersionsGetResponse",
      "path": "/shapes/com.cloudflare.workers#GetScriptVersionResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#GetScriptVersion/output/target",
      "value": "com.cloudflare.workers#GetScriptVersionResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#WorkerNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 10007
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#VersionNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 100146
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#GetScriptVersion/errors",
      "value": [
        {
          "target": "com.cloudflare.workers#WorkerNotFound"
        },
        {
          "target": "com.cloudflare.workers#VersionNotFound"
        }
      ]
