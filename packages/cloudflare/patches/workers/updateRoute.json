{
  "description": "Align workers#RoutesUpdate with distilled cloudflare/workers updateRoute",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#RoutesUpdate",
      "path": "/shapes/com.cloudflare.workers#UpdateRoute"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#RoutesUpdateRequest",
      "path": "/shapes/com.cloudflare.workers#UpdateRouteRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#UpdateRoute/input/target",
      "value": "com.cloudflare.workers#UpdateRouteRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#RoutesUpdateResponse",
      "path": "/shapes/com.cloudflare.workers#UpdateRouteResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#UpdateRoute/output/target",
      "value": "com.cloudflare.workers#UpdateRouteResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#RouteNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 10009
            },
            {
              "status": 404
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#InvalidRoutePattern",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 10022
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#UpdateRoute/errors",
      "value": [
        {
          "target": "com.cloudflare.workers#RouteNotFound"
        },
        {
          "target": "com.cloudflare.workers#InvalidRoutePattern"
        }
      ]
    }
  ]
}
