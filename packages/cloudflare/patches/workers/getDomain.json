{
  "description": "Align workers#DomainsGet with distilled cloudflare/workers getDomain",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#DomainsGet",
      "path": "/shapes/com.cloudflare.workers#GetDomain"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#DomainsGetRequest",
      "path": "/shapes/com.cloudflare.workers#GetDomainRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#GetDomain/input/target",
      "value": "com.cloudflare.workers#GetDomainRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#DomainsGetResponse",
      "path": "/shapes/com.cloudflare.workers#GetDomainResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#GetDomain/output/target",
      "value": "com.cloudflare.workers#GetDomainResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#DomainNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 100114
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#InvalidRoute",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 7003
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#GetDomain/errors",
      "value": [
        {
          "target": "com.cloudflare.workers#DomainNotFound"
        },
        {
          "target": "com.cloudflare.workers#InvalidRoute"
        }
      ]
    }
  ]
}
