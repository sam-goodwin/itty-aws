{
  "description": "Align workers#BetaWorkersGet with distilled cloudflare/workers getBetaWorker",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#BetaWorkersGet",
      "path": "/shapes/com.cloudflare.workers#GetBetaWorker"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#BetaWorkersGetRequest",
      "path": "/shapes/com.cloudflare.workers#GetBetaWorkerRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#GetBetaWorker/input/target",
      "value": "com.cloudflare.workers#GetBetaWorkerRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#BetaWorkersGetResponse",
      "path": "/shapes/com.cloudflare.workers#GetBetaWorkerResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#GetBetaWorker/output/target",
      "value": "com.cloudflare.workers#GetBetaWorkerResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#WorkerNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 10007
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#InvalidRoute",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 7003
            },
            {
              "code": 7003,
              "message": {
                "includes": "Could not route"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#GetBetaWorker/errors",
      "value": [
        {
          "target": "com.cloudflare.workers#WorkerNotFound"
        },
        {
          "target": "com.cloudflare.workers#InvalidRoute"
        }
      ]
    }
  ]
}
