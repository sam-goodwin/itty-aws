{
  "description": "Align workers#RoutesList with distilled cloudflare/workers listRoutes",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#RoutesList",
      "path": "/shapes/com.cloudflare.workers#ListRoutes"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#RoutesListRequest",
      "path": "/shapes/com.cloudflare.workers#ListRoutesRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#ListRoutes/input/target",
      "value": "com.cloudflare.workers#ListRoutesRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#RoutesListResponse",
      "path": "/shapes/com.cloudflare.workers#ListRoutesResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#ListRoutes/output/target",
      "value": "com.cloudflare.workers#ListRoutesResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#InvalidRoute",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 7003
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#ListRoutes/errors",
      "value": [
        {
          "target": "com.cloudflare.workers#InvalidRoute"
        },
        {
          "target": "com.cloudflare.workers#Forbidden"
        }
      ]
    }
  ]
}
