{
  "description": "Align workers#ScriptsGet with distilled cloudflare/workers getScript",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#ScriptsGet",
      "path": "/shapes/com.cloudflare.workers#GetScript"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#ScriptsGetRequest",
      "path": "/shapes/com.cloudflare.workers#GetScriptRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#GetScript/input/target",
      "value": "com.cloudflare.workers#GetScriptRequest"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#WorkerNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 10007
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#InvalidRoute",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 7003
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#GetScript/errors",
      "value": [
        {
          "target": "com.cloudflare.workers#WorkerNotFound"
        },
        {
          "target": "com.cloudflare.workers#InvalidRoute"
        }
      ]
    }
  ]
}
