      "path": "/shapes/com.cloudflare.workers#CreateScriptSubdomainRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#CreateScriptSubdomain/input/target",
      "value": "com.cloudflare.workers#CreateScriptSubdomainRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#ScriptsSubdomainCreateResponse",
      "path": "/shapes/com.cloudflare.workers#CreateScriptSubdomainResponse"
    },
    {
      "op": "replace",
