    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#ScriptsScriptAndVersionSettingsGetResponseExportsValue/members/state",
      "value": {
        "target": "com.cloudflare.workers#ScriptsScriptAndVersionSettingsGetResponseExportState"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#ScriptsScriptAndVersionSettingsGetResponseExportsValue/members/transfer_from",
      "value": { "target": "smithy.api#String" }
