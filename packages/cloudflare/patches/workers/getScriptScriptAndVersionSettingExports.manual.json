        "type": "enum",
        "members": {
          "SQLITE": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "sqlite" }
          },
          "LEGACY_KV": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "legacy-kv" }
          }
        }
      }
    },
    {
      "op": "add",
