          },
          "EXPECTING_TRANSFER": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "expecting-transfer" }
          }
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#ScriptsScriptAndVersionSettingsGetResponseExportsValue/members/storage",
