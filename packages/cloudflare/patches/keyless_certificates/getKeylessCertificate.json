{
  "description": "Align keyless_certificates#Get with distilled cloudflare/keyless-certificates getKeylessCertificate",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.keyless_certificates#Get",
      "path": "/shapes/com.cloudflare.keyless_certificates#GetKeylessCertificate"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.keyless_certificates#GetRequest",
      "path": "/shapes/com.cloudflare.keyless_certificates#GetKeylessCertificateRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.keyless_certificates#GetKeylessCertificate/input/target",
      "value": "com.cloudflare.keyless_certificates#GetKeylessCertificateRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.keyless_certificates#GetResponse",
      "path": "/shapes/com.cloudflare.keyless_certificates#GetKeylessCertificateResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.keyless_certificates#GetKeylessCertificate/output/target",
      "value": "com.cloudflare.keyless_certificates#GetKeylessCertificateResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.keyless_certificates#KeylessCertificateNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 1005,
              "message": {
                "includes": "Invalid or missing Keyless SSL"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.keyless_certificates#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.keyless_certificates#GetKeylessCertificate/errors",
      "value": [
        {
          "target": "com.cloudflare.keyless_certificates#KeylessCertificateNotFound"
        },
        {
          "target": "com.cloudflare.keyless_certificates#Forbidden"
        }
      ]
    }
  ]
}
