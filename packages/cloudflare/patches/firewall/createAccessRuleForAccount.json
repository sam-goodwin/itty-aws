{
  "description": "Align firewall#AccessRulesCreateForAccount with distilled cloudflare/firewall createAccessRuleForAccount",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.firewall#AccessRulesCreateForAccount",
      "path": "/shapes/com.cloudflare.firewall#CreateAccessRuleForAccount"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.firewall#AccessRulesCreateForAccountRequest",
      "path": "/shapes/com.cloudflare.firewall#CreateAccessRuleForAccountRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.firewall#CreateAccessRuleForAccount/input/target",
      "value": "com.cloudflare.firewall#CreateAccessRuleForAccountRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.firewall#AccessRulesCreateForAccountResponse",
      "path": "/shapes/com.cloudflare.firewall#CreateAccessRuleForAccountResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.firewall#CreateAccessRuleForAccount/output/target",
      "value": "com.cloudflare.firewall#CreateAccessRuleForAccountResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.firewall#DuplicateAccessRule",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 10009,
              "message": {
                "includes": "duplicate_of_existing"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.firewall#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.firewall#CreateAccessRuleForAccount/errors",
      "value": [
        {
          "target": "com.cloudflare.firewall#DuplicateAccessRule"
        },
        {
          "target": "com.cloudflare.firewall#Forbidden"
        }
      ]
    }
  ]
}
