{
  "description": "Align vectorize#IndexesList with distilled cloudflare/vectorize listIndexes",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.vectorize#IndexesList",
      "path": "/shapes/com.cloudflare.vectorize#ListIndexes"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.vectorize#IndexesListRequest",
      "path": "/shapes/com.cloudflare.vectorize#ListIndexesRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.vectorize#ListIndexes/input/target",
      "value": "com.cloudflare.vectorize#ListIndexesRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.vectorize#IndexesListResponse",
      "path": "/shapes/com.cloudflare.vectorize#ListIndexesResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.vectorize#ListIndexes/output/target",
      "value": "com.cloudflare.vectorize#ListIndexesResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.vectorize#NotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 3000
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.vectorize#Gone",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 3005
            },
            {
              "message": {
                "includes": "index deleted"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.vectorize#ListIndexes/errors",
      "value": [
        {
          "target": "com.cloudflare.vectorize#NotFound"
        },
        {
          "target": "com.cloudflare.vectorize#Gone"
        }
      ]
    }
  ]
}
