      "path": "/shapes/com.cloudflare.vectorize#CreateIndexResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.vectorize#CreateIndex/output/target",
      "value": "com.cloudflare.vectorize#CreateIndexResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.vectorize#IndexAlreadyExists",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 3002
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.vectorize#IndexInvalidName",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 3001
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.vectorize#IndexInvalidConfig",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 3003
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.vectorize#CreateIndex/errors",
      "value": [
        {
          "target": "com.cloudflare.vectorize#IndexAlreadyExists"
        },
        {
          "target": "com.cloudflare.vectorize#IndexInvalidName"
        },
        {
          "target": "com.cloudflare.vectorize#IndexInvalidConfig"
        }
      ]
    }
  ]
