{
  "description": "Align queues#SubscriptionsGet with distilled cloudflare/queues getSubscription",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.queues#SubscriptionsGet",
      "path": "/shapes/com.cloudflare.queues#GetSubscription"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.queues#SubscriptionsGetRequest",
      "path": "/shapes/com.cloudflare.queues#GetSubscriptionRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.queues#GetSubscription/input/target",
      "value": "com.cloudflare.queues#GetSubscriptionRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.queues#SubscriptionsGetResponse",
      "path": "/shapes/com.cloudflare.queues#GetSubscriptionResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.queues#GetSubscription/output/target",
      "value": "com.cloudflare.queues#GetSubscriptionResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#UnrecognizedEventType",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 0,
              "message": {
                "includes": "Unrecognized event types"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#SubscriptionNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 404,
              "message": {
                "includes": "No subscription with this ID"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#GetSubscription/errors",
      "value": [
        {
          "target": "com.cloudflare.queues#UnrecognizedEventType"
        },
        {
          "target": "com.cloudflare.queues#SubscriptionNotFound"
        },
        {
          "target": "com.cloudflare.queues#Forbidden"
        }
      ]
    }
  ]
}
