{
  "description": "Align queues#Get with distilled cloudflare/queues getQueue",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.queues#Get",
      "path": "/shapes/com.cloudflare.queues#GetQueue"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.queues#GetRequest",
      "path": "/shapes/com.cloudflare.queues#GetQueueRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.queues#GetQueue/input/target",
      "value": "com.cloudflare.queues#GetQueueRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.queues#GetResponse",
      "path": "/shapes/com.cloudflare.queues#GetQueueResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.queues#GetQueue/output/target",
      "value": "com.cloudflare.queues#GetQueueResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#QueueNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 11000
            },
            {
              "code": 0,
              "message": {
                "includes": "Queue does not exist"
              }
            },
            {
              "status": 404,
              "message": {
                "includes": "Queue does not exist"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#InvalidRoute",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 7003
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#GetQueue/errors",
      "value": [
        {
          "target": "com.cloudflare.queues#QueueNotFound"
        },
        {
          "target": "com.cloudflare.queues#InvalidRoute"
        }
      ]
    }
  ]
}
