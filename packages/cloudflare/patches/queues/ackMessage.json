{
  "description": "Align queues#MessagesAck with distilled cloudflare/queues ackMessage",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.queues#MessagesAck",
      "path": "/shapes/com.cloudflare.queues#AckMessage"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.queues#MessagesAckRequest",
      "path": "/shapes/com.cloudflare.queues#AckMessageRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.queues#AckMessage/input/target",
      "value": "com.cloudflare.queues#AckMessageRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.queues#MessagesAckResponse",
      "path": "/shapes/com.cloudflare.queues#AckMessageResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.queues#AckMessage/output/target",
      "value": "com.cloudflare.queues#AckMessageResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#InvalidRequestBody",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 10026
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#InvalidQueueId",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 10107
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#QueueNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 11000
            },
            {
              "code": 0,
              "message": {
                "includes": "Queue does not exist"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#InvalidRoute",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 7003
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#AckMessage/errors",
      "value": [
        {
          "target": "com.cloudflare.queues#InvalidRequestBody"
        },
        {
          "target": "com.cloudflare.queues#InvalidQueueId"
        },
        {
          "target": "com.cloudflare.queues#QueueNotFound"
        },
        {
          "target": "com.cloudflare.queues#InvalidRoute"
        }
      ]
    }
  ]
}
