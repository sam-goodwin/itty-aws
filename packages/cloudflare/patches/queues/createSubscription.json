{
  "description": "Align queues#SubscriptionsCreate with distilled cloudflare/queues createSubscription",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.queues#SubscriptionsCreate",
      "path": "/shapes/com.cloudflare.queues#CreateSubscription"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.queues#SubscriptionsCreateRequest",
      "path": "/shapes/com.cloudflare.queues#CreateSubscriptionRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.queues#CreateSubscription/input/target",
      "value": "com.cloudflare.queues#CreateSubscriptionRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.queues#SubscriptionsCreateResponse",
      "path": "/shapes/com.cloudflare.queues#CreateSubscriptionResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.queues#CreateSubscription/output/target",
      "value": "com.cloudflare.queues#CreateSubscriptionResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#UnrecognizedEventType",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 0,
              "message": {
                "includes": "Unrecognized event types"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#SubscriptionAlreadyExists",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 405,
              "message": {
                "includes": "do not support multiple subscriptions"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#QueueNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 11000
            },
            {
              "code": 0,
              "message": {
                "includes": "Queue does not exist"
              }
            },
            {
              "status": 404,
              "message": {
                "includes": "Queue does not exist"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#CreateSubscription/errors",
      "value": [
        {
          "target": "com.cloudflare.queues#UnrecognizedEventType"
        },
        {
          "target": "com.cloudflare.queues#SubscriptionAlreadyExists"
        },
        {
          "target": "com.cloudflare.queues#QueueNotFound"
        }
      ]
    }
  ]
}
