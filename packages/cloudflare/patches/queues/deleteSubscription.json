{
  "description": "Align queues#SubscriptionsDelete with distilled cloudflare/queues deleteSubscription",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.queues#SubscriptionsDelete",
      "path": "/shapes/com.cloudflare.queues#DeleteSubscription"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.queues#SubscriptionsDeleteRequest",
      "path": "/shapes/com.cloudflare.queues#DeleteSubscriptionRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.queues#DeleteSubscription/input/target",
      "value": "com.cloudflare.queues#DeleteSubscriptionRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.queues#SubscriptionsDeleteResponse",
      "path": "/shapes/com.cloudflare.queues#DeleteSubscriptionResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.queues#DeleteSubscription/output/target",
      "value": "com.cloudflare.queues#DeleteSubscriptionResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#UnrecognizedEventType",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 0,
              "message": {
                "includes": "Unrecognized event types"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#SubscriptionNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 404,
              "message": {
                "includes": "No subscription with this ID"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#DeleteSubscription/errors",
      "value": [
        {
          "target": "com.cloudflare.queues#UnrecognizedEventType"
        },
        {
          "target": "com.cloudflare.queues#SubscriptionNotFound"
        }
      ]
    }
  ]
}
