{
  "description": "Align ssl#CertificatePacksEdit with distilled cloudflare/ssl patchCertificatePack",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ssl#CertificatePacksEdit",
      "path": "/shapes/com.cloudflare.ssl#PatchCertificatePack"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ssl#CertificatePacksEditRequest",
      "path": "/shapes/com.cloudflare.ssl#PatchCertificatePackRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.ssl#PatchCertificatePack/input/target",
      "value": "com.cloudflare.ssl#PatchCertificatePackRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ssl#CertificatePacksEditResponse",
      "path": "/shapes/com.cloudflare.ssl#PatchCertificatePackResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.ssl#PatchCertificatePack/output/target",
      "value": "com.cloudflare.ssl#PatchCertificatePackResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.ssl#CertificatePackNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 1408
            },
            {
              "status": 404
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.ssl#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.ssl#PatchCertificatePack/errors",
      "value": [
        {
          "target": "com.cloudflare.ssl#CertificatePackNotFound"
        },
        {
          "target": "com.cloudflare.ssl#Forbidden"
        }
      ]
    }
  ]
}
