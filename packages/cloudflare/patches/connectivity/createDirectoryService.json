{
  "description": "Align connectivity#DirectoryServicesCreate with distilled cloudflare/connectivity createDirectoryService",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.connectivity#DirectoryServicesCreate",
      "path": "/shapes/com.cloudflare.connectivity#CreateDirectoryService"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.connectivity#DirectoryServicesCreateRequest",
      "path": "/shapes/com.cloudflare.connectivity#CreateDirectoryServiceRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.connectivity#CreateDirectoryService/input/target",
      "value": "com.cloudflare.connectivity#CreateDirectoryServiceRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.connectivity#DirectoryServicesCreateResponse",
      "path": "/shapes/com.cloudflare.connectivity#CreateDirectoryServiceResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.connectivity#CreateDirectoryService/output/target",
      "value": "com.cloudflare.connectivity#CreateDirectoryServiceResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.connectivity#VpcServiceNameAlreadyExists",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 5101,
              "message": {
                "includes": "already exists"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.connectivity#VpcTunnelNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 5101,
              "message": {
                "includes": "Tunnel ID Not Found"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.connectivity#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.connectivity#CreateDirectoryService/errors",
      "value": [
        {
          "target": "com.cloudflare.connectivity#VpcServiceNameAlreadyExists"
        },
        {
          "target": "com.cloudflare.connectivity#VpcTunnelNotFound"
        },
        {
          "target": "com.cloudflare.connectivity#Forbidden"
        }
      ]
    }
  ]
}
