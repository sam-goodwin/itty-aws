{
  "description": "Align connectivity#DirectoryServicesUpdate with distilled cloudflare/connectivity updateDirectoryService",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.connectivity#DirectoryServicesUpdate",
      "path": "/shapes/com.cloudflare.connectivity#UpdateDirectoryService"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.connectivity#DirectoryServicesUpdateRequest",
      "path": "/shapes/com.cloudflare.connectivity#UpdateDirectoryServiceRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.connectivity#UpdateDirectoryService/input/target",
      "value": "com.cloudflare.connectivity#UpdateDirectoryServiceRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.connectivity#DirectoryServicesUpdateResponse",
      "path": "/shapes/com.cloudflare.connectivity#UpdateDirectoryServiceResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.connectivity#UpdateDirectoryService/output/target",
      "value": "com.cloudflare.connectivity#UpdateDirectoryServiceResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.connectivity#VpcServiceNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 5104
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.connectivity#VpcServiceNameAlreadyExists",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 5101,
              "message": {
                "includes": "already exists"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.connectivity#VpcTunnelNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 5101,
              "message": {
                "includes": "Tunnel ID Not Found"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.connectivity#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.connectivity#UpdateDirectoryService/errors",
      "value": [
        {
          "target": "com.cloudflare.connectivity#VpcServiceNotFound"
        },
        {
          "target": "com.cloudflare.connectivity#VpcServiceNameAlreadyExists"
        },
        {
          "target": "com.cloudflare.connectivity#VpcTunnelNotFound"
        },
        {
          "target": "com.cloudflare.connectivity#Forbidden"
        }
      ]
    }
  ]
}
