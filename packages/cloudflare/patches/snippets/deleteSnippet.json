{
  "description": "Align snippets#Delete with distilled cloudflare/snippets deleteSnippet",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.snippets#Delete",
      "path": "/shapes/com.cloudflare.snippets#DeleteSnippet"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.snippets#DeleteRequest",
      "path": "/shapes/com.cloudflare.snippets#DeleteSnippetRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.snippets#DeleteSnippet/input/target",
      "value": "com.cloudflare.snippets#DeleteSnippetRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.snippets#DeleteResponse",
      "path": "/shapes/com.cloudflare.snippets#DeleteSnippetResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.snippets#DeleteSnippet/output/target",
      "value": "com.cloudflare.snippets#DeleteSnippetResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.snippets#SnippetNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 400,
              "message": {
                "includes": "snippet not found"
              }
            },
            {
              "status": 404
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.snippets#SnippetInUse",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 400,
              "message": {
                "includes": "still used"
              }
            },
            {
              "status": 409,
              "message": {
                "includes": "still used"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.snippets#DeleteSnippet/errors",
      "value": [
        {
          "target": "com.cloudflare.snippets#SnippetNotFound"
        },
        {
          "target": "com.cloudflare.snippets#SnippetInUse"
        }
      ]
    }
  ]
}
