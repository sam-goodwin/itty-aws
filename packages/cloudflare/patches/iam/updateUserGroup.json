{
  "description": "Align iam#UserGroupsUpdate with distilled cloudflare/iam updateUserGroup",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.iam#UserGroupsUpdate",
      "path": "/shapes/com.cloudflare.iam#UpdateUserGroup"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.iam#UserGroupsUpdateRequest",
      "path": "/shapes/com.cloudflare.iam#UpdateUserGroupRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.iam#UpdateUserGroup/input/target",
      "value": "com.cloudflare.iam#UpdateUserGroupRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.iam#UserGroupsUpdateResponse",
      "path": "/shapes/com.cloudflare.iam#UpdateUserGroupResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.iam#UpdateUserGroup/output/target",
      "value": "com.cloudflare.iam#UpdateUserGroupResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.iam#UserGroupNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 404,
              "message": {
                "includes": "User group"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.iam#UserGroupNameInUse",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 400,
              "message": {
                "includes": "already in use"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.iam#UpdateUserGroup/errors",
      "value": [
        {
          "target": "com.cloudflare.iam#UserGroupNotFound"
        },
        {
          "target": "com.cloudflare.iam#UserGroupNameInUse"
        }
      ]
    }
  ]
}
