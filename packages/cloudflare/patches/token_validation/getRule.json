{
  "description": "Align token_validation#RulesGet with distilled cloudflare/token-validation getRule",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.token_validation#RulesGet",
      "path": "/shapes/com.cloudflare.token_validation#GetRule"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.token_validation#RulesGetRequest",
      "path": "/shapes/com.cloudflare.token_validation#GetRuleRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.token_validation#GetRule/input/target",
      "value": "com.cloudflare.token_validation#GetRuleRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.token_validation#RulesGetResponse",
      "path": "/shapes/com.cloudflare.token_validation#GetRuleResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.token_validation#GetRule/output/target",
      "value": "com.cloudflare.token_validation#GetRuleResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.token_validation#TokenValidationRuleNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 404
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.token_validation#TokenValidationNotEntitled",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 10403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.token_validation#Forbidden",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.token_validation#GetRule/errors",
      "value": [
        {
          "target": "com.cloudflare.token_validation#TokenValidationRuleNotFound"
        },
        {
          "target": "com.cloudflare.token_validation#TokenValidationNotEntitled"
        },
        {
          "target": "com.cloudflare.token_validation#Forbidden"
        }
      ]
    }
  ]
}
