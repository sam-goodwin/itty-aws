{
  "description": "Align r2#BucketsDomainsCustomCreate with distilled cloudflare/r2 createBucketDomainCustom",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsDomainsCustomCreate",
      "path": "/shapes/com.cloudflare.r2#CreateBucketDomainCustom"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsDomainsCustomCreateRequest",
      "path": "/shapes/com.cloudflare.r2#CreateBucketDomainCustomRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.r2#CreateBucketDomainCustom/input/target",
      "value": "com.cloudflare.r2#CreateBucketDomainCustomRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsDomainsCustomCreateResponse",
      "path": "/shapes/com.cloudflare.r2#CreateBucketDomainCustomResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.r2#CreateBucketDomainCustom/output/target",
      "value": "com.cloudflare.r2#CreateBucketDomainCustomResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2#NoSuchBucket",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 10006
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2#InvalidBucketName",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 10005
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2#CustomDomainInUse",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 409,
              "message": {
                "includes": "in use"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2#CreateBucketDomainCustom/errors",
      "value": [
        {
          "target": "com.cloudflare.r2#NoSuchBucket"
        },
        {
          "target": "com.cloudflare.r2#InvalidBucketName"
        },
        {
          "target": "com.cloudflare.r2#CustomDomainInUse"
        }
      ]
    }
  ]
}
