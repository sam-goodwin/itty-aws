    "com.posthog.custom_property_definitions#CustomPropertyDefinition": {
      "type": "structure",
      "members": {
        "id": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#required": {}
          }
        },
        "name": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Human-readable name of the custom property. Unique within the team.",
            "smithy.api#required": {}
          }
        },
        "description": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Optional description of what the property represents.",
            "com.distilled.openapi#nullable": {}
          }
        },
        "display_type": {
          "target": "com.posthog.custom_property_definitions#CustomPropertyDisplayTypeEnum",
          "traits": {
            "smithy.api#documentation": "How the property is interpreted and rendered: 'text', 'number', 'currency', 'percent', 'date', 'datetime', 'boolean', or 'select'.\n\n* `text` - text\n* `number` - number\n* `currency` - currency\n* `percent` - percent\n* `date` - date\n* `datetime` - datetime\n* `boolean` - boolean\n* `select` - select",
            "smithy.api#required": {}
          }
        },
        "target_type": {
          "target": "com.posthog.custom_property_definitions#CustomPropertyDefinitionTargetTypeEnum",
          "traits": {
            "smithy.api#documentation": "What entity this property is attached to: 'account' (default), 'person', or 'group'. Person and group properties are populated from a warehouse schema and become usable like any other person/group property (feature flags, cohorts, insights).\n\n* `account` - account\n* `person` - person\n* `group` - group"
          }
        },
        "group_type_index": {
          "target": "smithy.api#Integer",
          "traits": {
            "smithy.api#documentation": "For 'group' targets only: which group type (0-4) the property attaches to. Required when target_type is 'group'; must be omitted otherwise. Create-only.",
            "com.distilled.openapi#nullable": {}
          }
        },
        "is_big_number": {
          "target": "smithy.api#Boolean",
          "traits": {
            "smithy.api#documentation": "Abbreviate large numbers (e.g. 10,000 → 10K). Only applies to numeric properties."
          }
        },
        "options": {
          "target": "com.posthog.custom_property_definitions#CustomPropertyDefinitionOptionsList",
          "traits": {
            "smithy.api#documentation": "For select properties: the allowed options. Required (non-empty) when display_type is 'select'; cleared server-side for other types.",
            "com.distilled.openapi#nullable": {}
          }
        },
        "source": {
          "target": "com.posthog.custom_property_definitions#CustomPropertySource",
          "traits": {
            "smithy.api#documentation": "The data-warehouse view-sync binding feeding this property, or null when values are set manually.",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "created_at": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#required": {}
          }
        },
        "created_by": {
          "target": "smithy.api#Integer",
          "traits": {
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "updated_at": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "references": {
          "target": "com.posthog.custom_property_definitions#CustomPropertyDefinitionReferencesList",
          "traits": {
            "smithy.api#documentation": "Workflows that use this property, resolved by definition id.",
            "smithy.api#required": {}
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "A team-scoped definition of a custom account property — the attribute side of the model.\n\nHolds only the property's shape (name, display type, big-number flag). Per-account values are\nstored separately, so this serializer never reads or writes account values."
      }
    },
