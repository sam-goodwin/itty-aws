          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Account sources only: UUID of the data-warehouse saved query (materialized view) to read values from. Mutually exclusive with external_data_schema.",
            "com.distilled.openapi#nullable": {}
          }
        },
        "external_data_schema": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Person and group sources only: UUID of the warehouse schema (raw incremental table) to read from. Mutually exclusive with saved_query.",
            "com.distilled.openapi#nullable": {}
          }
        },
        "source_column": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Account sources only: column in the view whose value is written to the property.",
            "com.distilled.openapi#nullable": {}
          }
        },
        "column_property_map": {
          "target": "smithy.api#Document",
          "traits": {
            "smithy.api#documentation": "Person and group sources only: {warehouse_column: property_name} mapping the columns this source writes onto the person or group."
          }
        },
        "key_column": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Column whose value identifies the target: an account's external_id for account sources, the person's distinct_id for person sources, or the group key for group sources.",
            "smithy.api#required": {}
          }
        },
        "is_enabled": {
          "target": "smithy.api#Boolean",
          "traits": {
            "smithy.api#documentation": "Whether the source syncs. Auto-disabled after repeated failures or a missing view; re-enabling resets the failure count."
          }
        },
        "consecutive_failures": {
          "target": "smithy.api#Integer",
          "traits": {
            "smithy.api#documentation": "Consecutive failed sync runs; the source auto-disables at the cap.",
            "smithy.api#required": {}
          }
        },
        "last_synced_at": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "When the most recent sync run finished.",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "last_sync_error": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Error summary from the last run, or null if it succeeded.",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "created_at": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#required": {}
          }
        },
        "created_by": {
          "target": "smithy.api#Integer",
          "traits": {
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "updated_at": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "sync_frequency_interval_seconds": {
          "target": "smithy.api#Double",
          "traits": {
            "smithy.api#documentation": "Person and group sources only: how often the underlying warehouse schema syncs, in seconds. Null for account sources or when unavailable.",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "next_sync_at": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Person and group sources only: approximate time of the next scheduled sync (last synced + interval). Approximate — drifts if the schedule was paused. Null for account sources or if never synced.",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "latest_run": {
          "target": "com.posthog.custom_property_definitions#CustomPropertySyncRun",
          "traits": {
            "smithy.api#documentation": "Person and group sources only: the most recent sync/backfill run, or null if none yet.",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "Binds a data-warehouse source to a custom property definition. Account sources read a\nmaterialized view column and sync onto matching accounts; person and group sources read a\nwarehouse schema and sync onto matching persons or groups on each warehouse sync."
      }
    },
