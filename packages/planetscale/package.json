{
  "name": "@distilled.cloud/planetscale",
  "version": "0.31.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./Category": {
      "types": "./src/category.ts",
      "bun": "./src/category.ts",
      "default": "./src/category.ts"
    },
    "./Credentials": {
      "types": "./src/credentials.ts",
      "bun": "./src/credentials.ts",
      "default": "./src/credentials.ts"
    },
    "./Errors": {
      "types": "./src/errors.ts",
      "bun": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./Operations": {
      "types": "./src/operations.ts",
      "bun": "./src/operations.ts",
      "default": "./src/operations.ts"
    },
    "./Pagination": {
      "types": "./src/pagination.ts",
      "bun": "./src/pagination.ts",
      "default": "./src/pagination.ts"
    },
    "./Protocol": {
      "types": "./src/protocol.ts",
      "bun": "./src/protocol.ts",
      "default": "./src/protocol.ts"
    },
    "./Retry": {
      "types": "./src/retry.ts",
      "bun": "./src/retry.ts",
      "default": "./src/retry.ts"
    },
    "./Traits": {
      "types": "./src/traits.ts",
      "bun": "./src/traits.ts",
      "default": "./src/traits.ts"
    },
    "./*": {
      "types": "./src/services/*.ts",
      "bun": "./src/services/*.ts",
      "default": "./src/services/*.ts"
    }
  },
  "scripts": {
    "convert": "bun scripts/convert.ts",
    "generate": "bun scripts/convert.ts && bun scripts/generate.ts",
    "typecheck": "tsgo -p tsconfig.json",
    "specs:fetch": "git submodule update --force --init --recursive --depth=1 specs/distilled-spec-planetscale && git -C specs/distilled-spec-planetscale checkout -- .",
    "specs:update": "git -C specs/distilled-spec-planetscale fetch && git -C specs/distilled-spec-planetscale checkout main && git -C specs/distilled-spec-planetscale pull"
  },
  "dependencies": {
    "@distilled.cloud/core": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:"
  }
}
