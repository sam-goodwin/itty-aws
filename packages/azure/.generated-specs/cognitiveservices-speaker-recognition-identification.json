      },
      "traits": {
        "smithy.api#documentation": "Speaker profile enrollment info"
      }
    },
    "com.azure.cognitiveservices_speaker_recognition_identification#EnrollmentStatus": {
      "type": "enum",
      "members": {
        "ENROLLING": {
          "target": "smithy.api#Unit",
          "traits": {
            "smithy.api#enumValue": "Enrolling"
          }
