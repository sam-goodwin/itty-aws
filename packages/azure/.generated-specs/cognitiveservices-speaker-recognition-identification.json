    "com.azure.cognitiveservices_speaker_recognition_identification#TextIndependentCreateEnrollment": {
      "type": "operation",
      "input": {
        "target": "com.azure.cognitiveservices_speaker_recognition_identification#TextIndependentCreateEnrollmentRequest"
