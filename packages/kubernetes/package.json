{
  "name": "@distilled.cloud/kubernetes",
  "version": "0.31.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./Credentials": {
      "types": "./src/credentials.ts",
      "bun": "./src/credentials.ts",
      "default": "./src/credentials.ts"
    },
    "./Errors": {
      "types": "./src/errors.ts",
      "bun": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./Traits": {
      "types": "./src/traits.ts",
      "bun": "./src/traits.ts",
      "default": "./src/traits.ts"
    },
    "./Protocol": {
      "types": "./src/protocol.ts",
      "bun": "./src/protocol.ts",
      "default": "./src/protocol.ts"
    },
    "./Retry": {
      "types": "./src/retry.ts",
      "bun": "./src/retry.ts",
      "default": "./src/retry.ts"
    },
    "./rbac-authorization": {
      "types": "./src/services/rbac_authorization.ts",
      "bun": "./src/services/rbac_authorization.ts",
      "default": "./src/services/rbac_authorization.ts"
    },
    "./flowcontrol-apiserver": {
      "types": "./src/services/flowcontrol_apiserver.ts",
      "bun": "./src/services/flowcontrol_apiserver.ts",
      "default": "./src/services/flowcontrol_apiserver.ts"
    },
    "./internal-apiserver": {
      "types": "./src/services/internal_apiserver.ts",
      "bun": "./src/services/internal_apiserver.ts",
      "default": "./src/services/internal_apiserver.ts"
    },
    "./*": {
      "types": "./src/services/*.ts",
      "bun": "./src/services/*.ts",
      "default": "./src/services/*.ts"
    }
  },
  "scripts": {
    "convert": "bun scripts/convert.ts",
    "generate": "bun scripts/convert.ts && bun scripts/generate.ts",
    "typecheck": "tsgo -p tsconfig.json",
    "specs:fetch": "git submodule update --force --init --recursive --depth=1 specs/kubernetes && git -C specs/kubernetes checkout -- .",
    "specs:update": "git -C specs/kubernetes fetch && git -C specs/kubernetes checkout master && git -C specs/kubernetes pull"
  },
  "dependencies": {
    "@distilled.cloud/core": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:"
  }
}
