{
  "openapi": "3.0.3",
  "info": {
    "title": "ACME (RFC 8555)",
    "version": "v2",
    "description": "Automatic Certificate Management Environment, hand-authored from RFC 8555. Every path here is a placeholder: the ACME protocol resolves `newNonce`/`newAccount`/`newOrder`/`revokeCert` from the CA's directory document and addresses accounts, orders, authorizations, challenges and certificates by the absolute URLs the CA hands back (the `url` path parameter). Every POST body is a JWS signed by the account key — see `src/protocol.ts`."
  },
  "servers": [{ "url": "https://acme.example/directory" }],
  "paths": {
    "/directory": {
      "get": {
        "operationId": "getDirectory",
        "summary": "Fetch the CA's directory of resource URLs",
        "responses": {
          "200": {
            "description": "Directory",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Directory" }
              }
            }
          }
        }
      }
    },
    "/newNonce": {
      "get": {
        "operationId": "newNonce",
        "summary": "Get a fresh anti-replay nonce (the `Replay-Nonce` header)",
        "responses": {
          "200": {
            "description": "Nonce",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NonceResponse" }
              }
            }
          }
        }
      }
    },
    "/newAccount": {
      "post": {
        "operationId": "newAccount",
        "summary": "Create an account, or find the existing account for this key",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewAccountRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing account for this key",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccountResponse" }
              }
            }
          },
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccountResponse" }
              }
            }
          }
        }
      }
    },
    "/account/{url}": {
      "post": {
        "operationId": "updateAccount",
        "summary": "Update (or deactivate) the account at `url`",
        "parameters": [{ "$ref": "#/components/parameters/url" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateAccountRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccountResponse" }
              }
            }
          }
        }
      }
    },
    "/newOrder": {
      "post": {
        "operationId": "newOrder",
        "summary": "Create an order for a set of identifiers",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewOrderRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrderResponse" }
              }
            }
          }
        }
      }
    },
    "/order/{url}": {
      "post": {
        "operationId": "getOrder",
        "summary": "Fetch the order at `url` (POST-as-GET)",
        "parameters": [{ "$ref": "#/components/parameters/url" }],
        "responses": {
          "200": {
            "description": "Order",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrderResponse" }
              }
            }
          }
        }
      }
    },
    "/finalize/{url}": {
      "post": {
        "operationId": "finalizeOrder",
        "summary": "Submit the CSR to the order's finalize URL",
        "parameters": [{ "$ref": "#/components/parameters/url" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FinalizeOrderRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrderResponse" }
              }
            }
          }
        }
      }
    },
    "/authz/{url}": {
      "post": {
        "operationId": "getAuthorization",
        "summary": "Fetch the authorization at `url` (POST-as-GET)",
        "parameters": [{ "$ref": "#/components/parameters/url" }],
        "responses": {
          "200": {
            "description": "Authorization",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Authorization" }
              }
            }
          }
        }
      }
    },
    "/authz/{url}/deactivate": {
      "post": {
        "operationId": "deactivateAuthorization",
        "summary": "Deactivate the authorization at `url`",
        "parameters": [{ "$ref": "#/components/parameters/url" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeactivateAuthorizationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorization",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Authorization" }
              }
            }
          }
        }
      }
    },
    "/challenge/{url}": {
      "post": {
        "operationId": "respondChallenge",
        "summary": "Tell the CA the challenge at `url` is ready to be validated",
        "parameters": [{ "$ref": "#/components/parameters/url" }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RespondChallengeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Challenge",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Challenge" }
              }
            }
          }
        }
      }
    },
    "/cert/{url}": {
      "post": {
        "operationId": "downloadCertificate",
        "summary": "Download the PEM certificate chain at `url` (POST-as-GET)",
        "parameters": [{ "$ref": "#/components/parameters/url" }],
        "responses": {
          "200": {
            "description": "PEM chain",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CertificateChain" }
              }
            }
          }
        }
      }
    },
    "/revokeCert": {
      "post": {
        "operationId": "revokeCertificate",
        "summary": "Revoke a certificate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevokeCertificateRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Revoked" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "url": {
        "name": "url",
        "in": "path",
        "required": true,
        "description": "Absolute URL of the resource, as returned by the CA.",
        "schema": { "type": "string" }
      }
    },
    "schemas": {
      "Directory": {
        "type": "object",
        "description": "RFC 8555 §7.1.1",
        "properties": {
          "newNonce": { "type": "string" },
          "newAccount": { "type": "string" },
          "newOrder": { "type": "string" },
          "newAuthz": { "type": "string" },
          "revokeCert": { "type": "string" },
          "keyChange": { "type": "string" },
          "meta": { "$ref": "#/components/schemas/DirectoryMeta" }
        },
        "required": ["newNonce", "newAccount", "newOrder", "revokeCert"]
      },
      "DirectoryMeta": {
        "type": "object",
        "properties": {
          "termsOfService": { "type": "string" },
          "website": { "type": "string" },
          "caaIdentities": { "type": "array", "items": { "type": "string" } },
          "externalAccountRequired": { "type": "boolean" }
        }
      },
      "NonceResponse": {
        "type": "object",
        "properties": {
          "replayNonce": {
            "type": "string",
            "description": "The `Replay-Nonce` header."
          }
        },
        "required": ["replayNonce"]
      },
      "Identifier": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "`dns` (RFC 8555) or `ip` (RFC 8738)."
          },
          "value": { "type": "string" }
        },
        "required": ["type", "value"]
      },
      "Problem": {
        "type": "object",
        "description": "RFC 7807 problem document (RFC 8555 §6.7).",
        "properties": {
          "type": { "type": "string" },
          "detail": { "type": "string" },
          "status": { "type": "integer" },
          "instance": { "type": "string" },
          "identifier": { "$ref": "#/components/schemas/Identifier" },
          "subproblems": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Subproblem" }
          }
        }
      },
      "Subproblem": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "detail": { "type": "string" },
          "identifier": { "$ref": "#/components/schemas/Identifier" }
        }
      },
      "ExternalAccountBinding": {
        "type": "object",
        "description": "A JWS binding this account to an existing CA account (RFC 8555 §7.3.4). The protocol builds it from the credentials' EAB key when the CA requires one.",
        "properties": {
          "protected": { "type": "string" },
          "payload": { "type": "string" },
          "signature": { "type": "string" }
        },
        "required": ["protected", "payload", "signature"]
      },
      "NewAccountRequest": {
        "type": "object",
        "properties": {
          "contact": { "type": "array", "items": { "type": "string" } },
          "termsOfServiceAgreed": { "type": "boolean" },
          "onlyReturnExisting": { "type": "boolean" },
          "externalAccountBinding": {
            "$ref": "#/components/schemas/ExternalAccountBinding"
          }
        }
      },
      "UpdateAccountRequest": {
        "type": "object",
        "properties": {
          "contact": { "type": "array", "items": { "type": "string" } },
          "status": {
            "type": "string",
            "description": "`deactivated` to deactivate the account."
          }
        }
      },
      "AccountResponse": {
        "type": "object",
        "description": "RFC 8555 §7.1.2, plus the `Location` header as `location`.",
        "properties": {
          "status": { "type": "string" },
          "contact": { "type": "array", "items": { "type": "string" } },
          "termsOfServiceAgreed": { "type": "boolean" },
          "orders": { "type": "string" },
          "location": {
            "type": "string",
            "description": "The account URL (`Location` header); the `kid` for every later request."
          }
        },
        "required": ["status"]
      },
      "NewOrderRequest": {
        "type": "object",
        "properties": {
          "identifiers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Identifier" }
          },
          "notBefore": { "type": "string" },
          "notAfter": { "type": "string" }
        },
        "required": ["identifiers"]
      },
      "OrderResponse": {
        "type": "object",
        "description": "RFC 8555 §7.1.3, plus the `Location` header as `location`.",
        "properties": {
          "status": {
            "type": "string",
            "description": "pending | ready | processing | valid | invalid"
          },
          "expires": { "type": "string" },
          "identifiers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Identifier" }
          },
          "notBefore": { "type": "string" },
          "notAfter": { "type": "string" },
          "error": { "$ref": "#/components/schemas/Problem" },
          "authorizations": { "type": "array", "items": { "type": "string" } },
          "finalize": { "type": "string" },
          "certificate": { "type": "string" },
          "location": {
            "type": "string",
            "description": "The order URL (`Location` header)."
          }
        },
        "required": ["status", "identifiers", "authorizations", "finalize"]
      },
      "FinalizeOrderRequest": {
        "type": "object",
        "properties": {
          "csr": {
            "type": "string",
            "description": "base64url DER PKCS#10 CSR."
          }
        },
        "required": ["csr"]
      },
      "Challenge": {
        "type": "object",
        "description": "RFC 8555 §8",
        "properties": {
          "type": {
            "type": "string",
            "description": "dns-01 | http-01 | tls-alpn-01"
          },
          "url": { "type": "string" },
          "status": {
            "type": "string",
            "description": "pending | processing | valid | invalid"
          },
          "validated": { "type": "string" },
          "token": { "type": "string" },
          "error": { "$ref": "#/components/schemas/Problem" }
        },
        "required": ["type", "url", "status"]
      },
      "Authorization": {
        "type": "object",
        "description": "RFC 8555 §7.1.4",
        "properties": {
          "identifier": { "$ref": "#/components/schemas/Identifier" },
          "status": {
            "type": "string",
            "description": "pending | valid | invalid | deactivated | expired | revoked"
          },
          "expires": { "type": "string" },
          "challenges": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Challenge" }
          },
          "wildcard": { "type": "boolean" }
        },
        "required": ["identifier", "status", "challenges"]
      },
      "DeactivateAuthorizationRequest": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "description": "Always `deactivated`." }
        },
        "required": ["status"]
      },
      "RespondChallengeRequest": {
        "type": "object",
        "description": "Empty object: the CA validates the challenge using the key authorization it already knows.",
        "properties": {}
      },
      "CertificateChain": {
        "type": "object",
        "properties": {
          "chain": {
            "type": "string",
            "description": "PEM certificate chain (`application/pem-certificate-chain`), leaf first."
          },
          "alternates": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Alternate chain URLs from `Link: <url>;rel=\"alternate\"` headers."
          }
        },
        "required": ["chain"]
      },
      "RevokeCertificateRequest": {
        "type": "object",
        "properties": {
          "certificate": {
            "type": "string",
            "description": "base64url DER of the certificate to revoke."
          },
          "reason": {
            "type": "integer",
            "description": "RFC 5280 CRLReason code."
          }
        },
        "required": ["certificate"]
      }
    }
  }
}
