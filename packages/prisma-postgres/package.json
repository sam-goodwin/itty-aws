{
  "name": "@distilled.cloud/prisma-postgres",
  "version": "0.31.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alchemy-run/distilled",
    "directory": "packages/prisma-postgres"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "module": "src/index.ts",
  "files": [
    "lib",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./Credentials": {
      "types": "./lib/credentials.d.ts",
      "bun": "./src/credentials.ts",
      "default": "./lib/credentials.js"
    },
    "./Errors": {
      "types": "./lib/errors.d.ts",
      "bun": "./src/errors.ts",
      "default": "./lib/errors.js"
    },
    "./Protocol": {
      "types": "./lib/protocol.d.ts",
      "bun": "./src/protocol.ts",
      "default": "./lib/protocol.js"
    },
    "./Retry": {
      "types": "./lib/retry.d.ts",
      "bun": "./src/retry.ts",
      "default": "./lib/retry.js"
    },
    "./Traits": {
      "types": "./lib/traits.d.ts",
      "bun": "./src/traits.ts",
      "default": "./lib/traits.js"
    },
    "./management": {
      "types": "./lib/services/management.d.ts",
      "bun": "./src/services/management.ts",
      "default": "./lib/services/management.js"
    },
    "./*": {
      "types": "./lib/services/*.d.ts",
      "bun": "./src/services/*.ts",
      "default": "./lib/services/*.js"
    }
  },
  "scripts": {
    "convert": "bun scripts/convert.ts",
    "generate": "bun scripts/generate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:strict": "tsc -p tsconfig.strict.json",
    "specs:fetch": "git submodule update --force --init --recursive --depth=1 specs/distilled-spec-prisma-postgres && git -C specs/distilled-spec-prisma-postgres checkout -- .",
    "specs:update": "git -C specs/distilled-spec-prisma-postgres fetch && git -C specs/distilled-spec-prisma-postgres checkout main && git -C specs/distilled-spec-prisma-postgres pull"
  },
  "dependencies": {
    "@distilled.cloud/core": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:"
  }
}
