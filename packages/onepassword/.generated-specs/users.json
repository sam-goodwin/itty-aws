        "filter": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#httpQuery": "filter",
            "smithy.api#documentation": "Filter users by state. Supported values (case-sensitive): `user.isActive()` or `user.isSuspended()`.\nOmit or leave empty to return both active and suspended users. Any other value returns `400 Bad Request` with an `invalid_argument` error."
          }
        },
        "max_page_size": {
          "target": "smithy.api#Integer",
          "traits": {
            "smithy.api#httpQuery": "max_page_size",
            "smithy.api#documentation": "The maximum number of users to return per page. Defaults to 100 when omitted or set to 0. The maximum is 1000; values greater than 1000 are limited to 1000, and negative values return `400 Bad Request`. Ignored when `page_token` is provided."
          }
        },
        "page_token": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#httpQuery": "page_token",
            "smithy.api#documentation": "The pagination token that identifies the page of results to return. Use the `next_page_token` value from a previous response, and send the same `filter` value as the original request. Tokens are opaque and don't expire."
          }
        }
      },
      "traits": {
        "smithy.api#input": {}
