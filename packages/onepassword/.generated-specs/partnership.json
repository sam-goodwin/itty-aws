    "com.onepassword.partnership#CreatePartnerAccountRequest": {
      "type": "structure",
      "members": {
        "customer_account_uid": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "A unique identifier for the end user's account to be provisioned. It can be up to 80 chars long and consist of alphanumeric characters and hyphens.",
            "smithy.api#required": {}
          }
        },
        "account_type": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Specifies the type of 1Password account plan to provision - 'I' for Individual, or 'F' for family.",
            "smithy.api#required": {}
          }
        },
        "domain": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Specifies the 1Password domain to provision the account for. For testing it can be one of 'b5test.com', 'b5test.ca', or 'b5test.eu'. For production, it can be one of '1password.com', '1password.ca', or '1password.eu'. Note that domains can only be used after promotions have been created for a given partnership in the specific domain.",
            "smithy.api#required": {}
          }
        },
        "ends_at": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Specifies when the 1Password account will be frozen, formatted in RFC-3339."
          }
        }
      },
      "traits": {
        "smithy.api#input": {}
      }
    },
    "com.onepassword.partnership#Account": {
      "type": "structure",
      "members": {
        "customer_account_uid": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The unique identifier for the end user's account. It can be up to 80 chars long and consist of alphanumeric characters and hyphens."
          }
        },
        "account_type": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The current type of the 1Password account - 'I' for Individual, or 'F' for family."
          }
        },
        "activation_token": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The activation token is a coupon code to link a new or existing 1Password account to a partnership promotion. For example, it can be used for 1Password account creation at https://start.{{1password_domain}}/partnership/redeem?t={{account_type}}&c={{activation_token}} during end-user signup."
          }
        },
        "domain": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The 1Password domain for which the account was provisioned for. For testing domains, it can be one of 'b5test.com', 'b5test.ca', or 'b5test.eu'. For production, it can be one of '1password.com', '1password.ca', or '1password.eu'."
          }
        },
        "status": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The provisioning status of the partner account. It can be either 'entitled' for accounts that have been initialized but have not completed 1Password signup, or 'provisioned' for accounts that have completed the 1Password signup process."
          }
        },
        "deployed_members": {
          "target": "smithy.api#Integer",
          "traits": {
            "smithy.api#documentation": "The number of provisioned users for the 1Password account."
          }
        },
        "created_at": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The timestamp of when the partnership account was created, formatted in RFC-3339."
          }
        },
        "updated_at": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The timestamp of when the partner account was last updated, formatted in RFC-3339. This field will be updated during account status changes."
          }
        },
        "ends_at": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The timestamp of when the partner account will be frozen, formatted in RFC-3339."
          }
        }
      },
      "traits": {}
