{
  "description": "storage: the store<->project connection endpoints are real but absent from the OpenAPI document (used by the Vercel CLI's `blob store add` flow; live-verified 2026-08-13 against the alchemy-test team). Adds getStorageStoreConnections (GET /storage/stores/{storeId}/connections -> {connections: [...]}) and createStorageStoreConnection (POST, body {projectId, envVarEnvironments, type: \"integration\"} -> 201 empty body; injects a BLOB_READ_WRITE_TOKEN encrypted env var into the connected project) plus deleteStorageStoreConnection (DELETE /storage/stores/{storeId}/connections/{connectionId} -> 201 empty body; also removes the injected env var). A duplicate connect returns 400 code `store_project_connection_not_unique`.",
  "patches": [
    {
      "op": "add",
      "path": "/paths/~1storage~1stores~1{storeId}~1connections",
      "value": {
        "get": {
          "description": "List the projects connected to a storage store.",
          "operationId": "getStorageStoreConnections",
          "security": [],
          "summary": "List store connections",
          "tags": [
            "storage"
          ],
          "parameters": [
            {
              "name": "storeId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              }
            },
            {
              "description": "The Team identifier to perform the request on behalf of.",
              "in": "query",
              "name": "teamId",
              "schema": {
                "type": "string"
              }
            },
            {
              "description": "The Team slug to perform the request on behalf of.",
              "in": "query",
              "name": "slug",
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "connections": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "projectId": {
                              "type": "string"
                            },
                            "project": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string"
                                },
                                "name": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "id",
                                "name"
                              ]
                            },
                            "envVarPrefix": {
                              "nullable": true,
                              "type": "string"
                            },
                            "envVarEnvironments": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "enum": [
                                  "development",
                                  "preview",
                                  "production"
                                ]
                              }
                            }
                          },
                          "required": [
                            "id",
                            "projectId",
                            "envVarEnvironments"
                          ]
                        }
                      }
                    },
                    "required": [
                      "connections"
                    ]
                  }
                }
              }
            },
            "400": {
              "description": ""
            },
            "401": {
              "description": ""
            },
            "403": {
              "description": ""
            },
            "404": {
              "description": ""
            },
            "410": {
              "description": ""
            },
            "429": {
              "description": ""
            }
          }
        },
        "post": {
          "description": "Connect a storage store to a project. Injects the store's token env var (e.g. BLOB_READ_WRITE_TOKEN) into the project for the chosen environments.",
          "operationId": "createStorageStoreConnection",
          "security": [],
          "summary": "Connect a store to a project",
          "tags": [
            "storage"
          ],
          "parameters": [
            {
              "name": "storeId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              }
            },
            {
              "description": "The Team identifier to perform the request on behalf of.",
              "in": "query",
              "name": "teamId",
              "schema": {
                "type": "string"
              }
            },
            {
              "description": "The Team slug to perform the request on behalf of.",
              "in": "query",
              "name": "slug",
              "schema": {
                "type": "string"
              }
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "projectId": {
                      "type": "string"
                    },
                    "envVarEnvironments": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "development",
                          "preview",
                          "production"
                        ]
                      }
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "integration"
                      ]
                    }
                  },
                  "required": [
                    "projectId",
                    "envVarEnvironments",
                    "type"
                  ]
                }
              }
            }
          },
          "responses": {
            "201": {
              "description": "The connection was created (empty body)."
            },
            "400": {
              "description": "Invalid request, or the project is already connected to the store in one of the chosen environments (code store_project_connection_not_unique)."
            },
            "401": {
              "description": ""
            },
            "402": {
              "description": ""
            },
            "403": {
              "description": ""
            },
            "404": {
              "description": ""
            },
            "410": {
              "description": ""
            },
            "429": {
              "description": ""
            }
          }
        }
      }
    },
    {
      "op": "add",
      "path": "/paths/~1storage~1stores~1{storeId}~1connections~1{connectionId}",
      "value": {
        "delete": {
          "description": "Disconnect a storage store from a project. Also removes the env var the connection injected into the project.",
          "operationId": "deleteStorageStoreConnection",
          "security": [],
          "summary": "Disconnect a store from a project",
          "tags": [
            "storage"
          ],
          "parameters": [
            {
              "name": "storeId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "connectionId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              }
            },
            {
              "description": "The Team identifier to perform the request on behalf of.",
              "in": "query",
              "name": "teamId",
              "schema": {
                "type": "string"
              }
            },
            {
              "description": "The Team slug to perform the request on behalf of.",
              "in": "query",
              "name": "slug",
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "201": {
              "description": "The connection was removed (empty body; the live API answers 201)."
            },
            "400": {
              "description": ""
            },
            "401": {
              "description": ""
            },
            "403": {
              "description": ""
            },
            "404": {
              "description": ""
            },
            "410": {
              "description": ""
            },
            "429": {
              "description": ""
            }
          }
        }
      }
    }
  ]
}
