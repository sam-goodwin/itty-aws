              "name": "teamId",
              "schema": {
                "type": "string"
              }
            },
            {
              "description": "The Team slug to perform the request on behalf of.",
              "in": "query",
              "name": "slug",
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
