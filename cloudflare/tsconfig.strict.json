{
  "extends": "../tsconfig.base.json",
  "include": ["sdk/**/*.ts"],
  // Full type checking for the hand-written sdk files only. sdk/index.ts is
  // excluded because it re-exports ./operations, which would pull every
  // generated module into the checked program.
  "exclude": ["sdk/operations", "sdk/index.ts"],
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@distilled.cloud/core/*": ["../packages/core/src/*"]
    }
  }
}
