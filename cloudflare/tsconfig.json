{
  "extends": "../tsconfig.base.json",
  "include": ["sdk/**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    // Ported from distilled PR #360: generated operations carry explicit
    // interfaces + `as any as S.Schema<T>` casts, so checking them buys
    // nothing and costs minutes/GBs. Hand-written sdk files are still checked
    // via tsconfig.strict.json (`bun run typecheck:strict`).
    "noCheck": true,
    "paths": {
      "@distilled.cloud/core/*": ["../packages/core/src/*"]
    }
  }
}
