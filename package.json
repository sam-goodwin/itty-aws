{
  "name": "distilled-v1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "generate": "bun scripts/generate-all.ts",
    "specs:sync": "git submodule sync --recursive && git submodule update --force --init --recursive --depth=1",
    "typecheck": "tsc -b",
    "format": "oxfmt '.'",
    "format:check": "bun run format -- --check",
    "lint": "oxlint",
    "prepare": "husky",
    "typecheck:ci": "tsc -b --noCheck false"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-bun": ">=4.0.0-beta.104 || >=4.0.0",
      "@effect/platform-node-shared": ">=4.0.0-beta.104 || >=4.0.0",
      "@effect/sql-pg": ">=4.0.0-beta.104 || >=4.0.0",
      "@types/bun": "latest",
      "@types/node": "latest",
      "typescript": "^7.0.2",
      "effect": ">=4.0.0-beta.104 || >=4.0.0",
      "@aws-crypto/crc32": "^5.2.0",
      "@aws-crypto/util": "^5.2.0",
      "@aws-sdk/credential-providers": "^3.994.0",
      "@aws-sdk/types": "^3.973.1",
      "@smithy/shared-ini-file-loader": "^4.4.3",
      "@smithy/types": "^4.12.0",
      "@smithy/util-base64": "^4.3.0",
      "aws4fetch": "^1.0.20",
      "fast-xml-parser": "^5.3.2",
      "dedent": "^1.7.0",
      "pathe": "^2.0.3"
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "typescript": "^7.0.2",
    "husky": "^9.1.7",
    "oxfmt": "latest",
    "oxlint": "latest"
  },
  "packageManager": "bun@1.3.13"
}
